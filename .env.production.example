# Production Compose env (copy to .env.production — never commit the real file).
#
# Use with:
#   docker compose -f docker-compose.prod.yml --env-file .env.production up -d api
#
# Required: point DATABASE_URL at managed PostgreSQL (not the dev compose postgres service).

CLOUDWRKZ_DEPLOYMENT=production

# Required — managed PostgreSQL connection string (include sslmode=require when supported)
DATABASE_URL=postgresql://USER:PASSWORD@db.example.com:5432/cloudwrkz?sslmode=require

# Required — public web origin(s), comma-separated
CORS_ORIGINS=https://app.example.com

COOKIE_DOMAIN=.example.com
COOKIE_SECURE=true
RUST_LOG=info

# Optional
# API_REGION=eu-west-1
# API_NODES_AVAILABLE=1
# API_HOST_PORT=8080
