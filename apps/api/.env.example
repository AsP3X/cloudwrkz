# Optional label surfaced in GET /api/v1/health (api.environment). Falls back to development/production from build profile.
# APP_ENV="staging"
# Set to `production` on live hosts — disables dev-only `migrate-repair` and marks production deploys.
# CLOUDWRKZ_DEPLOYMENT="development"
# Region label for this API instance (surfaced on /health for global routing). Override with: cloudwrkz-api --region eu-west-1
# API_REGION="eu-west-1"
# How many API nodes this deployment reports (single process = 1 until multi-endpoint). Override: --api-nodes N
# API_NODES_AVAILABLE=1

DATABASE_URL="postgresql://cloudwrkz:cloudwrkz_dev_password@localhost:5432/cloudwrkz"
# Startup: retry connecting forever (default). For CI use DATABASE_CONNECT_FAST_FAIL=true or DATABASE_CONNECT_MAX_WAIT_SECS=30
# DATABASE_CONNECT_FAST_FAIL="false"
# DATABASE_CONNECT_MAX_WAIT_SECS=""
# Pool: longer acquire timeout helps when the DB is recovering (seconds)
# DATABASE_POOL_ACQUIRE_TIMEOUT_SECS="15"
# DATABASE_POOL_MAX_CONNECTIONS="20"
# Retry migrations on transient DB errors for up to this many seconds (default 300)
# DATABASE_MIGRATE_RETRY_MAX_SECS="300"
API_HOST="0.0.0.0"
# Listen port for cloudwrkz-api. cloudwrkz-cli loads this file too: when CLOUDWRKZ_API_URL is unset,
# the CLI calls http://127.0.0.1:<API_PORT>/api/v1 (change both together for local dev).
API_PORT="8080"
# Vite may use 5174 if 5173 is in use; include both so CORS works when using VITE_API_URL to point at the API directly
CORS_ORIGINS="http://localhost:5173,http://localhost:5174,http://localhost:3000"
COOKIE_DOMAIN=""
COOKIE_SECURE="false"
SESSION_MAX_AGE="604800"
# Hard cap on session lifetime from first sign-in (seconds). Default 30 days.
SESSION_ABSOLUTE_MAX_AGE="2592000"
MAX_BODY_SIZE="10485760"
# Per-IP rate limit for POST/GET under /api/v1/auth/* (login, register, status polls, etc.).
# Refill interval is derived from AUTH_RATE_LIMIT_PER_MINUTE (sustained ≈ that many requests/minute per IP).
# AUTH_RATE_LIMIT_PER_MINUTE="60"
# AUTH_RATE_LIMIT_BURST="30"
# Optional plaintext Bearer token for GET /api/v1/health/detailed (ops). Prefer admin UI or
# `cloudwrkz-cli diagnostics-token generate` (or `cloudwrkz-api diagnostics-token generate`) — same DB hash; pick one for CI.
# DIAGNOSTICS_HEALTH_TOKEN=""
# Log verbosity for HTTP spans and default filter: prod (minimal) or debug (+ client details; default RUST_LOG includes jobs=debug for the background job queue)
# LOG_VERBOSITY="prod"
# Log level (tracing). Examples: info, debug, cloudwrkz_api=debug, warn. With LOG_VERBOSITY=prod you can still use RUST_LOG=info,jobs=debug for only job-queue debug lines.
RUST_LOG="info,cloudwrkz_api=debug"
# Optional: JSON logs for monitoring (Datadog, CloudWatch, etc.). Set to "json" for one JSON object per line
# LOG_FORMAT="json"

# --- Link website preview screenshots (headless Chromium; enabled in Docker API image) ---
# Docker Compose mounts api_uploads at CLOUDWRKZ_UPLOAD_ROOT (default /app/public/uploads in the image).
# Set LINK_SCREENSHOT_ENABLED=false to skip PNG prerender (metadata scrape still runs when allowed).
# CLOUDWRKZ_UPLOAD_ROOT="/app/public/uploads"
# LINK_SCREENSHOT_ENABLED="true"
# LINK_SCREENSHOT_CHROMIUM_PATH="/usr/bin/chromium"
# LINK_SCREENSHOT_WIDTH="1280"
# LINK_SCREENSHOT_HEIGHT="720"
# LINK_SCREENSHOT_TIMEOUT_SECS="45"

# --- GitHub link metadata jobs (background_jobs.github_link_metadata) ---
# Optional Personal Access Token: higher GitHub REST limits; in-process hourly cap below is skipped when set.
# GITHUB_TOKEN=""
# GITHUB_API_TOKEN=""   # alternative to GITHUB_TOKEN
# Max anonymous GitHub REST GETs per rolling hour for this process (GitHub allows ~60/hour per IP without auth).
# GITHUB_ANONYMOUS_MAX_REQUESTS_PER_HOUR="60"
# Max concurrent github_link_metadata worker tasks (each job may issue several GETs subject to the limiter).
# JOB_QUEUE_GITHUB_MAX_CONCURRENT="1"
