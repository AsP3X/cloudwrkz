# Copy to `.env` beside this file (ignored by git). Loaded only by cloudwrkz-cli; overrides apps/api/.env.
# Run `init-env.sh` or `init-env.ps1` from the repo root to create this file with a random bootstrap secret.
CLOUDWRKZ_BOOTSTRAP_SECRET=GENERATE_ME
# Get a token: cloudwrkz-cli login
# CLOUDWRKZ_TOKEN=
# Optional override (default uses API_PORT from apps/api/.env):
# CLOUDWRKZ_API_URL=http://127.0.0.1:8081/api/v1
