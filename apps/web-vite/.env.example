# When running Vite in Docker Compose, the repo root docker-compose sets DOCKER_API_PROXY_TARGET
# (e.g. http://api:8080) so the dev server proxies /api to the API container. Do not set VITE_API_URL
# to a Docker-internal hostname — the browser cannot resolve it.

# API base URL.
# In local dev, relative "/api/v1" uses the Vite proxy to the Rust API (see vite.config.ts).
# If you see ECONNRESET / "socket hang up" on API calls (e.g. when Postgres is restarting),
# bypass the proxy with an absolute URL (empty CORS_ORIGINS on the API allows any origin; auth uses Bearer, not cookies):
# VITE_API_URL=http://127.0.0.1:8081/api/v1
# Open the app via the same host you use in CORS if you set CORS_ORIGINS (e.g. http://172.25.x.x:5173 for LAN).
# For production builds, set these explicitly to your public endpoints.
VITE_API_URL="/api/v1"
VITE_SEARCH_API_URL="/next-api"

# Application name displayed in the UI.
VITE_APP_NAME="CloudWrkz"

# Log level: trace | debug | info | warn | error | silent
# Default in code: info (dev), warn (prod)
VITE_LOG_LEVEL="info"

# Log output format. Set to "json" for NDJSON logs.
# Leave empty or use "text" for human-readable console logs.
VITE_LOG_FORMAT="text"
