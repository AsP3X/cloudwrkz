# API Base URL - used in production only. In dev we use the Vite proxy (/api -> API) to avoid CORS.
# VITE_API_URL="https://api.example.com/api/v1"

# Application name displayed in the UI
VITE_APP_NAME="CloudWrkz"

# Log level (same style as API: trace | debug | info | warn | error | silent). Default: info in dev, warn in prod
# VITE_LOG_LEVEL="info"
