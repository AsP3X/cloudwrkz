# Database Configuration (required for `pnpm start` / `pnpm start:local`)
# Copy this file to .env.local and set DATABASE_URL before running the production server.
# Run `./scripts/setup-db.sh` to automatically create the database and user
# Default credentials match the setup script:
#   Database: cloudwrkz
#   User: cloudwrkz
#   Password: cloudwrkz_dev_password
DATABASE_URL="postgresql://cloudwrkz:cloudwrkz_dev_password@localhost:5432/cloudwrkz?schema=public"

# NextAuth.js Configuration
# Generate a secure secret: openssl rand -base64 32
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="your-secret-key-here-change-in-production"
NEXT_SERVER_ACTIONS_ENCRYPTION_KEY="cloudwrkz"

# Application Configuration
NODE_ENV="development"
# Customize the application name displayed in the UI (defaults to "CloudWrkz" if not set)
NEXT_PUBLIC_APP_NAME="CloudWrkz"

# Reverse Proxy Configuration (for dev server behind proxy)
# If running dev server behind a reverse proxy (e.g., nginx), ensure the proxy
# is configured to upgrade WebSocket connections for /_next/webpack-hmr path
# Example nginx config:
#   location /_next/webpack-hmr {
#     proxy_pass http://localhost:3000;
#     proxy_http_version 1.1;
#     proxy_set_header Upgrade $http_upgrade;
#     proxy_set_header Connection "upgrade";
#     proxy_set_header Host $host;
#   }
