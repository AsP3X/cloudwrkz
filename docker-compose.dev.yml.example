# LOCAL DEVELOPMENT ONLY — do not run production workloads or store irreplaceable data here.
#
# Usage (from repo root):
#   cp docker-compose.dev.yml.example docker-compose.yml
#   docker compose up -d --build
#
# Or without copying:
#   docker compose -f docker-compose.dev.yml.example up -d --build
#
# Production: use docker-compose.prod.yml.example with managed PostgreSQL (RDS, etc.).
# Never use `docker compose down -v` unless you intend to destroy ALL local dev DB data.
# Prefer: scripts/compose-dev-down.sh (never removes volumes unless explicitly confirmed).

name: cloudwrkz-dev

services:
  api:
    build:
      context: ${CLOUDWRKZ_REPO_ROOT:-.}
      dockerfile: apps/api/Dockerfile
    container_name: cloudwrkz-dev-api
    restart: unless-stopped
    environment:
      CLOUDWRKZ_DEPLOYMENT: development
      DATABASE_URL: "postgresql://cloudwrkz:${POSTGRES_PASSWORD:-cloudwrkz_dev_password}@postgres:5432/cloudwrkz"
      API_HOST: "0.0.0.0"
      API_PORT: "8080"
      CORS_ORIGINS: "http://localhost:5173,http://localhost:3000"
      COOKIE_DOMAIN: ""
      COOKIE_SECURE: "false"
      RUST_LOG: "info,cloudwrkz_api=debug"
    ports:
      - "8080:8080"
    depends_on:
      postgres:
        condition: service_healthy
    healthcheck:
      test: ["CMD", "curl", "-f", "http://localhost:8080/api/health"]
      interval: 10s
      timeout: 5s
      retries: 12
      start_period: 90s
    networks:
      - cloudwrkz-dev-network

  web-vite:
    build:
      context: ${CLOUDWRKZ_REPO_ROOT:-.}
      dockerfile: apps/web-vite/Dockerfile
    image: cloudwrkz-web-vite:local
    container_name: cloudwrkz-dev-web-vite
    working_dir: /workspace
    # Do not mount the repo over /workspace — that hides node_modules baked in at image build time.
    ports:
      - "5173:5173"
    environment:
      CLOUDWRKZ_DEPLOYMENT: development
      # Dev proxy only (see apps/web-vite/vite.config.ts). Do not use VITE_API_URL=http://api:… — the browser cannot resolve Docker service names.
      DOCKER_API_PROXY_TARGET: "http://api:8080"
      CLOUD_WRKZ_DEV_ALLOWED_HOSTS: ${CLOUD_WRKZ_DEV_ALLOWED_HOSTS:-}
    depends_on:
      api:
        condition: service_healthy
    networks:
      - cloudwrkz-dev-network

  postgres:
    image: postgres:16-alpine
    container_name: cloudwrkz-dev-postgres
    restart: unless-stopped
    environment:
      POSTGRES_USER: cloudwrkz
      POSTGRES_PASSWORD: ${POSTGRES_PASSWORD:-cloudwrkz_dev_password}
      POSTGRES_DB: cloudwrkz
      PGDATA: /var/lib/postgresql/data/pgdata
    ports:
      - "${POSTGRES_HOST_PORT:-5433}:5432"
    volumes:
      - postgres_data:/var/lib/postgresql/data
    healthcheck:
      test: ["CMD-SHELL", "pg_isready -U cloudwrkz"]
      interval: 10s
      timeout: 5s
      retries: 5
    networks:
      - cloudwrkz-dev-network

volumes:
  postgres_data:
    name: cloudwrkz_postgres_data
    labels:
      cloudwrkz.dev-only: "true"
      cloudwrkz.warning: "LOCAL DEV DATA — not for production"

networks:
  cloudwrkz-dev-network:
    name: cloudwrkz-dev-network
    driver: bridge
