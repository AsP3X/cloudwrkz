# Local development stack — Vite dev server (hot reload) + API + Postgres.
#
# Usage (from repo root):
#   docker compose -f docker-compose.dev.yml.example up -d --build
#
# Or copy to gitignored docker-compose.yml for the default `docker compose` command:
#   cp docker-compose.dev.yml.example docker-compose.yml
#
# Open http://localhost:5173 — Vite proxies /api to the API container (DOCKER_API_PROXY_TARGET).
# For production static assets (nginx + dist/), use docker-compose.yml.example instead.
#
# Never use `docker compose down -v` unless you intend to destroy ALL local dev DB data.
# Prefer: COMPOSE_FILE=docker-compose.dev.yml.example scripts/compose-dev-down.sh

services:
  init-env:
    image: alpine:latest
    container_name: cloudwrkz-init-env
    volumes:
      - .:/workspace
    working_dir: /workspace
    # Human: Strip CR before running the script — YAML must not interpret \r as escape (use ''\r'' in single-quoted sh -c).
    # Agent: RUNS tr -d literal CR; WRITES /tmp/init-env.sh; EXEC sh; PROFILE init only.
    command:
      - sh
      - -c
      - 'tr -d ''\r'' < /workspace/init-env.sh > /tmp/init-env.sh && sh /tmp/init-env.sh'
    profiles:
      - init

  api:
    build:
      context: ${CLOUDWRKZ_REPO_ROOT:-.}
      dockerfile: apps/api/Dockerfile
    container_name: cloudwrkz-api
    restart: unless-stopped
    environment:
      CLOUDWRKZ_DEPLOYMENT: development
      DATABASE_URL: "postgresql://cloudwrkz:${POSTGRES_PASSWORD:-cloudwrkz_dev_password}@postgres:5432/cloudwrkz"
      API_HOST: "0.0.0.0"
      API_PORT: "8080"
      CORS_ORIGINS: "http://localhost:5173,http://localhost:3000"
      COOKIE_DOMAIN: ""
      COOKIE_SECURE: "false"
      RUST_LOG: "info,cloudwrkz_api=debug"
    ports:
      - "8080:8080"
    depends_on:
      postgres:
        condition: service_healthy
    healthcheck:
      test: ["CMD", "curl", "-f", "http://localhost:8080/api/health"]
      interval: 10s
      timeout: 5s
      retries: 12
      start_period: 90s
    networks:
      - cloudwrkz-network

  web-vite:
    build:
      context: ${CLOUDWRKZ_REPO_ROOT:-.}
      dockerfile: apps/web-vite/Dockerfile.dev
    image: cloudwrkz-web-vite:dev
    container_name: cloudwrkz-web-vite
    working_dir: /workspace
    restart: unless-stopped
    ports:
      - "5173:5173"
    environment:
      CLOUDWRKZ_DEPLOYMENT: development
      DOCKER_API_PROXY_TARGET: "http://api:8080"
      CLOUD_WRKZ_DEV_ALLOWED_HOSTS: ${CLOUD_WRKZ_DEV_ALLOWED_HOSTS:-}
    depends_on:
      api:
        condition: service_healthy
    healthcheck:
      test: ["CMD-SHELL", "wget -q -O /dev/null http://127.0.0.1:5173/ || exit 1"]
      interval: 15s
      timeout: 5s
      retries: 8
      start_period: 45s
    networks:
      - cloudwrkz-network

  postgres:
    image: postgres:16-alpine
    container_name: cloudwrkz-postgres
    restart: unless-stopped
    environment:
      POSTGRES_USER: cloudwrkz
      POSTGRES_PASSWORD: ${POSTGRES_PASSWORD:-cloudwrkz_dev_password}
      POSTGRES_DB: cloudwrkz
      PGDATA: /var/lib/postgresql/data/pgdata
    ports:
      - "${POSTGRES_HOST_PORT:-5433}:5432"
    volumes:
      - postgres_data:/var/lib/postgresql/data
    healthcheck:
      test: ["CMD-SHELL", "pg_isready -U cloudwrkz"]
      interval: 10s
      timeout: 5s
      retries: 5
    networks:
      - cloudwrkz-network

volumes:
  postgres_data:
    name: cloudwrkz_postgres_data
    labels:
      cloudwrkz.dev-only: "true"
      cloudwrkz.warning: "LOCAL DEV DATA — not for production"

networks:
  cloudwrkz-network:
    driver: bridge
