# Default local stack — production Vite build served by nginx (port 5173 → nginx :80).
#
# Prefer copying this file explicitly:
#   cp docker-compose.yml.example docker-compose.yml
#   docker compose up -d --build
#
# Hot-reload development (Vite dev server): docker-compose.dev.yml.example
#   docker compose -f docker-compose.dev.yml.example up -d --build

services:
  init-env:
    image: alpine:latest
    container_name: cloudwrkz-init-env
    volumes:
      - .:/workspace
    working_dir: /workspace
    # Human: Strip CR before running the script — YAML must not interpret \r as escape (use ''\r'' in single-quoted sh -c).
    # Agent: RUNS tr -d literal CR; WRITES /tmp/init-env.sh; EXEC sh; PROFILE init only.
    command:
      - sh
      - -c
      - 'tr -d ''\r'' < /workspace/init-env.sh > /tmp/init-env.sh && sh /tmp/init-env.sh'
    profiles:
      - init

  api:
    build:
      context: ${CLOUDWRKZ_REPO_ROOT:-.}
      dockerfile: apps/api/Dockerfile
    container_name: cloudwrkz-api
    restart: unless-stopped
    environment:
      CLOUDWRKZ_DEPLOYMENT: development
      DATABASE_URL: "postgresql://cloudwrkz:${POSTGRES_PASSWORD:-cloudwrkz_dev_password}@postgres:5432/cloudwrkz"
      API_HOST: "0.0.0.0"
      API_PORT: "8080"
      CORS_ORIGINS: "http://localhost:5173,http://localhost:3000"
      COOKIE_DOMAIN: ""
      COOKIE_SECURE: "false"
      RUST_LOG: "info,cloudwrkz_api=debug"
    ports:
      - "8080:8080"
    depends_on:
      postgres:
        condition: service_healthy
    healthcheck:
      test: ["CMD", "curl", "-f", "http://localhost:8080/api/health"]
      interval: 10s
      timeout: 5s
      retries: 12
      start_period: 90s
    networks:
      - cloudwrkz-network

  web-vite:
    build:
      context: ${CLOUDWRKZ_REPO_ROOT:-.}
      dockerfile: apps/web-vite/Dockerfile
      args:
        VITE_API_URL: "/api/v1"
        VITE_APP_NAME: "CloudWrkz"
    image: cloudwrkz-web-vite:local
    container_name: cloudwrkz-web-vite
    restart: unless-stopped
    ports:
      - "5173:80"
    depends_on:
      api:
        condition: service_healthy
    healthcheck:
      test: ["CMD", "wget", "-q", "-O", "/dev/null", "http://127.0.0.1/"]
      interval: 15s
      timeout: 5s
      retries: 5
      start_period: 15s
    networks:
      - cloudwrkz-network

  postgres:
    image: postgres:16-alpine
    container_name: cloudwrkz-postgres
    restart: unless-stopped
    environment:
      POSTGRES_USER: cloudwrkz
      POSTGRES_PASSWORD: ${POSTGRES_PASSWORD:-cloudwrkz_dev_password}
      POSTGRES_DB: cloudwrkz
      PGDATA: /var/lib/postgresql/data/pgdata
    ports:
      - "${POSTGRES_HOST_PORT:-5433}:5432"
    volumes:
      - postgres_data:/var/lib/postgresql/data
    healthcheck:
      test: ["CMD-SHELL", "pg_isready -U cloudwrkz"]
      interval: 10s
      timeout: 5s
      retries: 5
    networks:
      - cloudwrkz-network

volumes:
  postgres_data:
    name: cloudwrkz_postgres_data
    labels:
      cloudwrkz.dev-only: "true"
      cloudwrkz.warning: "LOCAL DEV DATA — not for production"

networks:
  cloudwrkz-network:
    driver: bridge
