{
  "name": "cloudwrkz",
  "version": "0.1.0",
  "private": true,
  "license": "PROPRIETARY",
  "engines": {
    "node": ">=25.2.0",
    "pnpm": ">=9.0.0"
  },
  "scripts": {
    "dev": "next dev -H 0.0.0.0",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "db:generate": "dotenv -e .env.local -- prisma generate",
    "db:push": "dotenv -e .env.local -- prisma db push",
    "db:migrate": "dotenv -e .env.local -- prisma migrate dev",
    "db:reset": "dotenv -e .env.local -- prisma db push --force-reset --skip-generate && dotenv -e .env.local -- prisma generate",
    "db:studio": "dotenv -e .env.local -- prisma studio",
    "db:setup": "bash scripts/setup-db.sh",
    "db:seed-permissions": "dotenv -e .env.local -- tsx scripts/seed-permissions.ts",
    "cli": "dotenv -e .env.local -- tsx src/cli/index.ts"
  },
  "dependencies": {
    "@hookform/resolvers": "^3.9.1",
    "@prisma/client": "^5.20.0",
    "bcryptjs": "^2.4.3",
    "clsx": "^2.1.1",
    "fuse.js": "^7.1.0",
    "next": "^16.0.7",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-hook-form": "^7.53.0",
    "recharts": "^3.4.1",
    "tailwind-merge": "^2.5.4",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.1",
    "@types/bcryptjs": "^2.4.6",
    "@types/inquirer": "^9.0.9",
    "@types/node": "^24.10.1",
    "@types/react": "^18.3.11",
    "@types/react-dom": "^18.3.0",
    "autoprefixer": "^10.4.20",
    "baseline-browser-mapping": "^2.9.0",
    "boxen": "^7.1.1",
    "chalk": "^5.6.2",
    "cli-table3": "^0.6.5",
    "dotenv-cli": "^11.0.0",
    "eslint": "^9.39.1",
    "eslint-config-next": "^16.0.3",
    "inquirer": "^9.3.8",
    "ora": "^8.2.0",
    "postcss": "^8.4.47",
    "prisma": "^5.20.0",
    "tailwindcss": "^3.4.13",
    "tsx": "^4.20.6",
    "typescript": "^5.6.3"
  },
  "pnpm": {
    "overrides": {
      "glob": ">=10.5.0"
    }
  }
}
