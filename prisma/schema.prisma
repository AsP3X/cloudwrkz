// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  USER
  ADMIN
  MODERATOR
  AGENT
}

enum UserStatus {
  PENDING
  ACTIVE
  SUSPENDED
  DELETED
}

model User {
  id        String     @id @default(cuid())
  email     String     @unique
  emailVerified Boolean @default(false)
  name      String?
  password  String     // Hashed password
  role      Role       @default(USER)
  status    UserStatus @default(PENDING)
  
  // Email verification
  emailVerificationToken String?
  emailVerificationExpires DateTime?
  
  // Password reset
  passwordResetToken String?
  passwordResetExpires DateTime?
  
  // Profile
  avatar    String?
  bio       String?
  
  // Metadata
  lastLoginAt DateTime?
  lastLoginIp String?
  
  // Relations
  sessions  Session[]
  createdTickets Ticket[] @relation("TicketCreator")
  assignedTickets Ticket[] @relation("TicketAssignee")
  ticketComments TicketComment[]
  groupMemberships GroupMembership[]
  
  // Timestamps
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  
  @@index([email])
  @@index([emailVerificationToken])
  @@index([passwordResetToken])
  @@map("users")
}

// Session model for user authentication
model Session {
  id        String   @id @default(cuid())
  token     String   @unique
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  
  @@index([token])
  @@index([userId])
  @@index([expiresAt])
  @@map("sessions")
}

// Module management - controls which modules are enabled
model Module {
  id          String   @id @default(cuid())
  key         String   @unique // e.g., "tickets", "accounting", "timetracking"
  name        String   // Display name
  description String?
  enabled     Boolean  @default(false)
  config      Json?    // Module-specific configuration
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([key])
  @@index([enabled])
  @@map("modules")
}

// Ticket Priority
enum TicketPriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

// Ticket Status
enum TicketStatus {
  OPEN
  IN_PROGRESS
  PENDING
  RESOLVED
  CLOSED
  CANCELLED
}

// Ticket Type
enum TicketType {
  BUG
  FEATURE
  QUESTION
  SUPPORT
  TASK
}

// Agent Groups - only for agents
model Group {
  id          String   @id @default(cuid())
  name        String   @unique
  description String?
  
  // Relations
  members     GroupMembership[]
  tickets    Ticket[]
  
  // Timestamps
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  
  @@index([name])
  @@map("groups")
}

// Many-to-many relationship between Users (agents) and Groups
model GroupMembership {
  id        String   @id @default(cuid())
  userId    String
  groupId   String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  group     Group    @relation(fields: [groupId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  
  @@unique([userId, groupId])
  @@index([userId])
  @@index([groupId])
  @@map("group_memberships")
}

// Ticket model for the ticket system module
model Ticket {
  id          String         @id @default(cuid())
  ticketNumber String        @unique // e.g., #INC-000001, #SRC-000001
  title       String
  description String?
  type        TicketType      @default(SUPPORT)
  status      TicketStatus    @default(OPEN)
  priority    TicketPriority  @default(MEDIUM)
  
  // Relations
  createdById String
  createdBy   User            @relation("TicketCreator", fields: [createdById], references: [id], onDelete: Restrict)
  assignedToId String?
  assignedTo User?           @relation("TicketAssignee", fields: [assignedToId], references: [id], onDelete: SetNull)
  assignedToGroupId String?
  assignedToGroup Group?    @relation(fields: [assignedToGroupId], references: [id], onDelete: SetNull)
  
  // Ticket metadata
  tags        String[]        @default([])
  attachments String[]       @default([])
  
  // Relations
  comments    TicketComment[]
  
  // Timestamps
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt
  resolvedAt  DateTime?
  closedAt    DateTime?

  @@index([createdById])
  @@index([assignedToId])
  @@index([assignedToGroupId])
  @@index([status])
  @@index([priority])
  @@index([type])
  @@index([ticketNumber])
  @@index([createdAt])
  @@map("tickets")
}

// Ticket Comments
model TicketComment {
  id         String   @id @default(cuid())
  content    String
  ticketId   String
  ticket     Ticket   @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Restrict)
  isAgentOnly Boolean @default(false)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([ticketId])
  @@index([userId])
  @@map("ticket_comments")
}
